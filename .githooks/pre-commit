#!/bin/sh
# Auto-bump SW / PWA cache-bust id on every commit so deploys always purge stale caches.
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$ROOT" || exit 0

if command -v node >/dev/null 2>&1; then
  node scripts/stamp-cache-version.js || exit 1
  # Stage ONLY the files the stamp script writes. Never `git add -- *.html`:
  # two agents share this working tree, so a blanket add sweeps the other
  # agent's in-progress work into your commit. See AGENTS.md.
  git add sw.js qg-pwa.js qg-build-id.json
fi

exit 0
